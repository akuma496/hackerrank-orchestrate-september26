# Copy to `.env` and fill in locally. `.env` is gitignored; never commit real keys.
# Only the LLM agents (planner routing, evidence interpretation) read a key.
# No market-data, banking, web-search, or exchange-rate APIs are used: all data is in dataset/.

# LLM provider for agent reasoning: none | anthropic | gemini
BOW_LLM_PROVIDER=none
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
BOW_PLANNER_MODEL=claude-opus-5
BOW_EVIDENCE_MODEL=claude-opus-5

# Paths are relative to the repository root.
BOW_DATASET_DIR=dataset
BOW_OUTPUT_PATH=output.csv
BOW_LLM_CACHE_DIR=code/.cache/llm

# Structured JSON logging: DEBUG | INFO | WARNING | ERROR
BOW_LOG_LEVEL=INFO
BOW_LOG_FILE=logs/run.jsonl

# Deterministic policy knobs
BOW_MAX_REFLECTIONS=2
BOW_MAX_PLANNER_STEPS=40
BOW_FORECAST_HORIZON_DAYS=90
